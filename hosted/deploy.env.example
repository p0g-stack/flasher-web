# flasher_web hosted build service (operator environment; do not expose this file)
# Required
HOSTED_ROOT=/var/lib/flasher-web-hosted
HOSTED_UPSTREAM_DIR=/srv/flasher-web/upstream
HOSTED_TOKEN=replace-with-at-least-32-random-characters
HOSTED_API_ORIGIN=https://edge.example.com
# Required, immutable: deployed builder/core/Rust commit or build id. Bump on
# every builder deploy; otherwise completed ZIPs remain cache-key matches.
HOSTED_BUILDER_REVISION=replace-with-deployed-commit-or-build-id
# The edge proxy backend origin, not this service's public URL.
# Loopback/private bind only; terminate TLS/authenticate at the edge proxy.
HOSTED_BIND=127.0.0.1
HOSTED_PORT=8080
HOSTED_CONCURRENCY=2
HOSTED_MAX_QUEUE=32
HOSTED_CACHE_BYTES=214748364800
HOSTED_MIN_FREE_BYTES=8589934592
HOSTED_MAX_OTA_BYTES=34359738368
HOSTED_MAX_ARTIFACT_BYTES=32212254720
HOSTED_JOB_DISK_BYTES=51539607552
HOSTED_RETENTION_DAYS=150
HOSTED_OTA_RETENTION_DAYS=150
HOSTED_LEASE_TTL_SECONDS=900
HOSTED_LEASE_MAX_SECONDS=43200
HOSTED_MAX_LEASES_PER_JOB=8
HOSTED_CPU_SECONDS=7200
HOSTED_CPU_PERCENT=200
HOSTED_CPU_PERIOD_US=100000
# Required for CPU utilization caps: a delegated cgroup v2 subtree writable by
# this service. Example systemd unit: Delegate=yes, CPUAccounting=yes.
# HOSTED_CGROUP_ROOT=/sys/fs/cgroup/hosted-builds
HOSTED_JOB_TIMEOUT_SECONDS=21600
HOSTED_CATALOG_MAX_STALE_SECONDS=21600
HOSTED_PRLIMIT=prlimit
# Optional: absolute path to a Dart script or compiled build worker.
# Default: bin/build_worker[.dart] beside the server executable.
# HOSTED_BUILD_WORKER=/opt/flasher-web-hosted/bin/build_worker
# Optional: comma-separated OTA host suffixes; defaults cover the upstream CDNs.
# HOSTED_ALLOWED_OTA_HOSTS=allawnofs.com,allawnos.com,oneplus.com,oppo.com
# Native library for the build pipeline and OTA inspection.
# P0G_NATIVE_LIB=/opt/flasher-web-hosted/libflasher_web.so
