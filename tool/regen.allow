# Files generated by p0g_app that this app changes or leaves out on purpose:
# one path per line, then `# <reason>`. tool/regen.sh does not compare them.
# Each entry must name a generated file and appear once across this file and
# tool/regen.add. Keep these header lines; add entries below them.
README.md # Product workflows, dependency qualification and third-party licensing.
app/lib/main.dart # Product shell binds its local FlasherService and guided OTA workflow.
app/pubspec.yaml # Product Flutter plugins and explicit qualified UI/picker dependencies.
app/test/widget_test.dart # Product setup, guided flashing and runtime widget coverage.
cli/test/runner_test.dart # Product command inventory replaces the empty sample-free runner expectations.
core/lib/flasher_web_core.dart # Product exports replace digest seed exports; shared native diagnostics remain exported.
rust/src/api/mod.rs # Product OTA, archive, partition and fastboot APIs replace the digest seed.
app/lib/home.dart # Product setup and runtime shell replace the generated home screen.
app/lib/panels/panels.dart # Product guided screens replace the generated panel registry.
app/lib/panels/place_header.dart # Product environment UI replaces the generated panel header.
app/lib/places/places.dart # Product page binds LocalPlace directly; core process and CLI support remain.
app/lib/places/launch.dart # Product page has no generated process-launch selector.
app/lib/places/launch_io.dart # Product page has no native process-launch UI; CLI serve is retained.
app/lib/places/launch_stub.dart # Product page has no generated launch abstraction requiring a stub.
app/lib/places/launch_web.dart # Product page has no launch UI; core WebUI launcher remains generated.
core/lib/src/strategy/digest.dart # Product Rust OTA operations replace the demonstration digest objective.
core/test/digest_test.dart # Product Rust/OTA tests replace the removed seed digest test.
rust/src/api/digest.rs # Product hashing and OTA APIs replace the unused digest seed.
