# Files generated by p0g_app that this app only adds lines to: one path per
# line, then `# <reason>`. tool/regen.sh checks that every generated line is
# still there, in order. This file and tool/regen.allow are always checked
# that way and cannot be listed. Keep these header lines; add entries below.
.gitignore # Product upstream snapshot, Worker dependencies and local secrets remain untracked.
pubspec.yaml # Product e2e and transport workspace packages plus upstream-sync archive dependency.
core/pubspec.yaml # Product device_link and HTTP dependencies alongside generated stack pins.
cli/lib/src/runner.dart # Register product bloat, devices, export and flash commands.
cli/lib/src/commands/serve_command.dart # Register FlasherService while retaining empty-registry safety.
core/lib/src/facts/facts.dart # Product filesystem path, handle, OPFS and picker capability keys.
core/lib/src/facts/check_io.dart # Check the product filesystem capabilities in native places.
core/lib/src/facts/check_web.dart # Check OPFS and picker capabilities separately in page and workers.
rust/Cargo.toml # Product transport, payload and partition crates, codecs and qualified nusb fork.
tool/bootstrap.sh # Sync the pinned product upstream snapshot only after the generated bootstrap.
